# --- Vertex AI (Step 3.1) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash-lite
# Path to a service account JSON key with roles/aiplatform.user, for local dev.
# On Cloud Run this isn't needed — the service's attached service account is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Firestore / Firebase Auth (Step 3.2-3.3) ---
# Firebase config object (Project Settings > General > Your apps), Auth only
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Cloud Storage (Step 3.4) ---
GCS_BUCKET_NAME=

# --- Document AI (Step 3.6) ---
# Document AI processors live in "us" or "eu" multi-region locations, not
# standard GCP regions — this is deliberately separate from GOOGLE_CLOUD_LOCATION.
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio WhatsApp sender, e.g. whatsapp:+17372508034 — this is account
# specific and is NOT Twilio's shared sandbox number.
TWILIO_WHATSAPP_FROM=
# The sandbox join phrase Twilio assigned you (Messaging > Try it out > Send a
# WhatsApp message). Read at runtime and served by /api/whatsapp/config, so it
# can be corrected without a rebuild.
TWILIO_SANDBOX_JOIN_CODE=
